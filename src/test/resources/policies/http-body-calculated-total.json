{
  "schemaVersion": "1.3",
  "requestHeaders": [],
  "responseHeaders": [],
  "metricPolicies": [],
  "methodPolicies": [],
  "bodyEventPolicies": [
    {
      "id": "order-approved-calculated-total-v1",
      "enabled": true,
      "ruleName": "Approved order with calculated total",
      "direction": "INCOMING",
      "requestContentType": "application/json",
      "responseContentType": "application/json",
      "conditions": [
        {
          "source": "REQUEST_PATH",
          "path": "",
          "operator": "EQUALS",
          "values": ["/api/orders"]
        },
        {
          "source": "REQUEST_METHOD",
          "path": "",
          "operator": "EQUALS",
          "values": ["POST"]
        },
        {
          "source": "RESPONSE_STATUS",
          "path": "",
          "operator": "IN",
          "values": ["200", "201"]
        },
        {
          "source": "RESPONSE_BODY",
          "path": "status",
          "operator": "EQUALS",
          "values": ["APPROVED"]
        }
      ],
      "eventName": "order-approved",
      "staticAttributes": [
        {
          "attribute": "event.provider",
          "value": "orders-api",
          "type": "STRING",
          "destinations": ["SPAN", "LOG"]
        },
        {
          "attribute": "event.type",
          "value": "order-approved",
          "type": "STRING",
          "destinations": ["SPAN", "LOG"]
        }
      ],
      "maxBodyBytes": 65536,
      "fields": [
        {
          "attribute": "order.quantity",
          "source": "REQUEST_BODY",
          "path": "quantity",
          "type": "LONG",
          "destinations": ["SPAN", "LOG"],
          "valuePolicy": {
            "type": "RANGE",
            "allowed": [],
            "fallback": "OTHER",
            "ranges": []
          }
        },
        {
          "attribute": "order.unit_price",
          "source": "REQUEST_BODY",
          "path": "unitPrice",
          "type": "DOUBLE",
          "destinations": ["SPAN", "LOG"],
          "valuePolicy": {
            "type": "RANGE",
            "allowed": [],
            "fallback": "OTHER",
            "ranges": []
          }
        },
        {
          "attribute": "business.channel",
          "source": "REQUEST_BODY",
          "path": "channel",
          "type": "STRING",
          "destinations": ["SPAN", "LOG", "METRIC"],
          "valuePolicy": {
            "type": "ENUM",
            "allowed": ["WEB", "MOBILE", "API"],
            "fallback": "OTHER",
            "ranges": []
          }
        }
      ],
      "derivedFields": [
        {
          "attribute": "transaction.total",
          "expression": "order.quantity * order.unit_price",
          "type": "DOUBLE",
          "destinations": ["SPAN", "LOG"],
          "valuePolicy": {
            "type": "RANGE",
            "allowed": [],
            "fallback": "OTHER",
            "ranges": []
          }
        }
      ],
      "log": {
        "enabled": true,
        "severity": "INFO",
        "body": "Approved order captured"
      }
    }
  ],
  "eventMetricPolicies": [
    {
      "id": "approved-order-count-v1",
      "enabled": true,
      "eventName": "order-approved",
      "name": "biz.order.approved.count",
      "instrument": "COUNTER",
      "unit": "1",
      "description": "Approved orders",
      "valueField": "",
      "dimensions": ["business.channel"],
      "buckets": []
    },
    {
      "id": "approved-order-total-v1",
      "enabled": true,
      "eventName": "order-approved",
      "name": "biz.order.total",
      "instrument": "HISTOGRAM",
      "unit": "PEN",
      "description": "Distribution and sum of calculated approved order totals",
      "valueField": "transaction.total",
      "dimensions": ["business.channel"],
      "buckets": [10, 50, 100, 500, 1000, 5000, 10000]
    }
  ]
}
